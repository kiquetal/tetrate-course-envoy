{
  "node": {
    "id": "local-task-01",
    "cluster": "web-gateway"
  },
  "admin": {
    "address": {
      "socket_address": {
        "address": "0.0.0.0",
        "port_value": 15000
      }
    }
  },
  "dynamic_resources": {
    "cds_config": {
      "path_config_source": {
        "path": "/etc/envoy/dynamic_clusters.json"
      },
      "resource_api_version": "V3"
    }
  },
  "static_resources": {
    "listeners": [
      {
        "name": "ingress_listener",
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 9901
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.tcp_proxy",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy",
                  "stat_prefix": "tcp_proxy",
                  "cluster": "backend_service"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
