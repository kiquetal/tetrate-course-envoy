{
  "version_info": "2",
  "resources": [
    {
      "@type": "type.googleapis.com/envoy.config.cluster.v3.Cluster",
      "name": "backend_service",
      "connect_timeout": "0.25s",
      "type": "STRICT_DNS",
      "lb_policy": "ROUND_ROBIN",
      "load_assignment": {
        "cluster_name": "backend_service",
        "endpoints": [
          {
            "lb_endpoints": [
              {
                "endpoint": {
                  "address": {
                    "socket_address": {
                      "address": "backend-v2",
                      "port_value": 8080
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}