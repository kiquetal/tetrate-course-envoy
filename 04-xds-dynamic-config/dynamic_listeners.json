{
  "version_info": "1",
  "resources": [
    {
      "@type": "type.googleapis.com/envoy.config.listener.v3.Listener",
      "name": "dynamic_ingress_listener",
      "address": {
        "socket_address": {
          "address": "0.0.0.0",
          "port_value": 9901
        }
      },
      "filter_chains": [
        {
          "filters": [
            {
              "name": "envoy.filters.network.tcp_proxy",
              "typed_config": {
                "@type": "type.googleapis.com/envoy.extensions.network.tcp_proxy.v3.TcpProxy",
                "stat_prefix": "dynamic_tcp_proxy",
                "cluster": "dynamic_backend_service"
              }
            }
          ]
        }
      ]
    }
  ]
}
